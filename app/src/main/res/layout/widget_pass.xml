<?xml version="1.0" encoding="utf-8"?>
<!-- v1.6：组件只挂一张 ImageView。整张画面（卡片/波浪/全部文字）由
     WidgetRenderer 按组件实际像素 1:1 渲染，和 App 内预览同一条管线。
     不再用 RemoteViews 的 TextView/布局 API——MIUI 启动器对这些 API 的
     单位处理和原生安卓不一致，v2.2 与 v1.4/v1.5 的真机文字消失都出在这一层。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/art"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="@string/widget_desc" />

</FrameLayout>
